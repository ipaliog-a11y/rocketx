{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/web",
    "src/sim",
    "src/vehicles.ts",
    "src/missions.ts",
    "src/contracts.ts",
    "vite.config.ts"
  ]
}
